{
	"name": "openscreen-mcp",
	"version": "0.1.0",
	"private": true,
	"description": "Local MCP server for editing OpenScreen recordings with Claude",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest --run",
		"vendor:schema": "bash scripts/vendor-schema.sh"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^22.20.4",
		"esbuild": "^0.28.2",
		"typescript": "~5.9.3",
		"vitest": "^4.0.18"
	}
}
